MODEL_PATH=models/leaf_disease_seg.onnx
MODEL_VERSION=yolo26x-seg-lds-v2
# Class names by model class id; leave empty to read them from the model (YOLO) or use the
# Roboflow COCO order "_superclass,leaf,leaf_spot,powdery_mildew" (RF-DETR)
CLASS_NAMES=
FIREBASE_PROJECT_ID=
# Empty = no images stored on the server; the app keeps them on the device (no Blaze plan needed)
STORAGE_BUCKET=
# Service-account JSON for local runs, kept outside the repo. Leave empty on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=
CORS_ORIGINS=http://localhost:5000,http://localhost:8080
# Confidence thresholds, tuned on the validation split for this model (training/09_tune_inference.ipynb).
# LEAF_SPOT_CONFIDENCE / POWDERY_MILDEW_CONFIDENCE override DISEASE_CONFIDENCE per disease.
LEAF_CONFIDENCE=0.2
DISEASE_CONFIDENCE=0.3
LEAF_SPOT_CONFIDENCE=0.25
POWDERY_MILDEW_CONFIDENCE=0.3
# AI management tips: any OpenAI-compatible chat API. Default = local Ollama (`ollama pull qwen2.5:7b`).
# Groq: LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-20b, LLM_API_KEY=gsk_...
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_S=120
# Looks at the leaf photo first (`ollama pull qwen2.5vl:7b`); its observations go to LLM_MODEL. Empty = skip the photo.
LLM_VISION_MODEL=qwen2.5vl:7b
